<Window x:Class="Kil0bitSystemMonitor.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:helpers="clr-namespace:Kil0bitSystemMonitor.Helpers"
        Title="Color"
        MinWidth="460" Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark">
    <Window.Resources>
        <!-- Множитель высоты трека относительно OpacityHost.Height (править в XAML/дизайнере) -->
        <sys:Double x:Key="OpacityTrackHeightFactor">0.5</sys:Double>
        <helpers:MultiplyConverter x:Key="MultiplyConverter"/>
        <helpers:HalfCornerRadiusConverter x:Key="HalfCornerRadiusConverter"/>

        <!-- Компактные поля: высота от padding+шрифта, без дефолтного MinHeight ModernWpf (~32) -->
        <Style x:Key="CompactTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CompactChannelTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Color" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- SV plane -->
            <Border x:Name="SvHost" Grid.Column="0" CornerRadius="6" ClipToBounds="True"
                    Height="220" Cursor="Cross"
                    MouseLeftButtonDown="SvHost_MouseLeftButtonDown"
                    MouseMove="SvHost_MouseMove"
                    MouseLeftButtonUp="SvHost_MouseLeftButtonUp">
                <Grid>
                    <Border x:Name="SvHueFill"/>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse x:Name="SvCursor" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                             IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="SvCursorTransform" X="-7" Y="-7"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Border>

            <!-- Hue -->
            <Border x:Name="HueHost" Grid.Column="1" CornerRadius="6" ClipToBounds="True" Cursor="Hand"
                    Height="220"
                    MouseLeftButtonDown="HueHost_MouseLeftButtonDown"
                    MouseMove="HueHost_MouseMove"
                    MouseLeftButtonUp="HueHost_MouseLeftButtonUp">
                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFF0000" Offset="0.00"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                                <GradientStop Color="#FF00FF00" Offset="0.33"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.50"/>
                                <GradientStop Color="#FF0000FF" Offset="0.67"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                                <GradientStop Color="#FFFF0000" Offset="1.00"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="HueCursor" Height="4" BorderBrush="White" BorderThickness="1"
                            Background="#AA000000" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Preview -->
            <Border Grid.Column="3" Width="72" Height="72" CornerRadius="8" VerticalAlignment="Top"
                    BorderBrush="#66FFFFFF" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Rectangle>
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#FF2A2A2A" Geometry="M0,0 H8 V8 H0 Z"/>
                                        <GeometryDrawing Brush="#FF444444" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z"/>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border x:Name="PreviewFill" Background="White"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Opacity 0–100: label сверху — длинная локализация не жмёт трек -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock x:Name="OpacityLabel" Text="Opacity" FontSize="11" Opacity="0.7" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="OpacityHost" Height="20" Background="Transparent" Cursor="Hand"
                        ClipToBounds="False" VerticalAlignment="Center"
                        MouseLeftButtonDown="OpacityHost_MouseLeftButtonDown"
                        MouseMove="OpacityHost_MouseMove"
                        MouseLeftButtonUp="OpacityHost_MouseLeftButtonUp">
                    <Grid>
                        <!-- Высота = OpacityHost.Height × OpacityTrackHeightFactor (см. Resources) -->
                        <Border x:Name="OpacityTrack" VerticalAlignment="Center"
                                Background="#33FFFFFF" ClipToBounds="True"
                                IsHitTestVisible="False"
                                CornerRadius="{Binding Height, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfCornerRadiusConverter}}">
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource MultiplyConverter}">
                                    <Binding ElementName="OpacityHost" Path="Height"/>
                                    <Binding Source="{StaticResource OpacityTrackHeightFactor}"/>
                                </MultiBinding>
                            </Border.Height>
                            <Border x:Name="OpacityFill" HorizontalAlignment="Left"
                                    Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                    IsHitTestVisible="False"
                                    CornerRadius="{Binding CornerRadius, ElementName=OpacityTrack}"/>
                        </Border>
                        <Ellipse x:Name="OpacityThumb"
                                 Width="{Binding ElementName=OpacityHost, Path=Height}"
                                 Height="{Binding ElementName=OpacityHost, Path=Height}"
                                 Fill="White" Stroke="#33000000" StrokeThickness="1"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="OpacityThumbTransform" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Border>
                <TextBox x:Name="OpacityBox" Grid.Column="1" Margin="10,0,0,0"
                         Style="{StaticResource CompactChannelTextBoxStyle}"
                         LostFocus="OpacityBox_LostFocus" KeyDown="Field_KeyDown"/>
            </Grid>
        </StackPanel>

        <!-- Hex тянется (*), RGB — Auto по контенту (как flex-shrink) -->
        <Grid Grid.Row="3" Margin="0,0,0,16" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Channel"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Channel"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Channel"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HexLabel" Text="Hex" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <TextBox x:Name="HexBox" Style="{StaticResource CompactTextBoxStyle}"
                         LostFocus="HexBox_LostFocus" KeyDown="Field_KeyDown"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="R" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <TextBox x:Name="RBox" Style="{StaticResource CompactChannelTextBoxStyle}"
                         LostFocus="RgbBox_LostFocus" KeyDown="Field_KeyDown"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="G" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <TextBox x:Name="GBox" Style="{StaticResource CompactChannelTextBoxStyle}"
                         LostFocus="RgbBox_LostFocus" KeyDown="Field_KeyDown"/>
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="B" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <TextBox x:Name="BBox" Style="{StaticResource CompactChannelTextBoxStyle}"
                         LostFocus="RgbBox_LostFocus" KeyDown="Field_KeyDown"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" MinWidth="96" Margin="0,0,8,0" Click="CancelBtn_Click"/>
            <Button x:Name="OkBtn" Content="OK" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" Click="OkBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
