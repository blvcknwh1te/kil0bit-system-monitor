<Window
    x:Class="Kil0bitSystemMonitor.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:Kil0bitSystemMonitor"
    mc:Ignorable="d"
    Title="Kil0bit System Monitor Settings"
    Height="720" Width="1000"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:ThemeManager.RequestedTheme="Dark">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Единые токены раскладки настроек (все вкладки / локали) -->
        <Thickness x:Key="SettingsPageMargin">24</Thickness>
        <Thickness x:Key="SettingsCardMargin">0,0,0,12</Thickness>
        <Thickness x:Key="SettingsCardPadding">16,4</Thickness>
        <Thickness x:Key="SettingsIconGap">0,0,16,0</Thickness>
        <Thickness x:Key="SettingsTextControlGap">0,0,16,0</Thickness>
        <Thickness x:Key="SettingsFieldLabelMargin">0,0,0,8</Thickness>
        <sys:Double x:Key="SettingsSectionTitleSize">28</sys:Double>
        <sys:Double x:Key="SettingsControlMinWidth">200</sys:Double>
        <sys:Double x:Key="SettingsColorButtonHeight">36</sys:Double>
        <sys:Double x:Key="SettingsSwatchSize">18</sys:Double>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlElevationBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="{StaticResource SettingsCardMargin}"/>
            <Setter Property="Padding" Value="{StaticResource SettingsCardPadding}"/>
        </Style>
        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="{StaticResource SettingsFieldLabelMargin}"/>
        </Style>
        <Style x:Key="SettingsControlStyle" TargetType="FrameworkElement">
            <Setter Property="MinWidth" Value="{StaticResource SettingsControlMinWidth}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="SettingsComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingsToggleStyle" TargetType="ui:ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MaxWidth" Value="44"/>
        </Style>
        <Style x:Key="SettingsColorButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="{StaticResource SettingsColorButtonHeight}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="SettingsRoot" Loaded="SettingsRoot_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:NavigationView x:Name="SettingsNav" 
                        Grid.Row="0"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        SelectionChanged="SettingsNav_SelectionChanged">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home" Tag="Home" IsSelected="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="General" Tag="General">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Setting" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Monitoring" Tag="Monitoring">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="FourBars" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Appearance" Tag="Appearance">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Edit" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="About" Tag="About">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Help" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Margin="{StaticResource SettingsPageMargin}" Grid.IsSharedSizeScope="True">
                    <!-- Home Section -->
                    <StackPanel x:Name="HomeSection" Visibility="Visible">
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock Text="Welcome" FontSize="42" FontWeight="Bold" Foreground="White" Margin="0,0,0,4">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.3" ShadowDepth="2"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="Kil0bit System Monitor is active and tracking your hardware performance with near-zero overhead." 
                                       FontSize="17" Opacity="0.7" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>

                        <UniformGrid Columns="2" HorizontalAlignment="Left">
                            <!-- General Card -->
                            <Button x:Name="HomeGeneralBtn" Click="HomeCard_Click" Tag="General" Width="280" Height="110" Margin="0,0,16,16" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" 
                                        BorderThickness="1" 
                                        Padding="16" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Setting" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="General" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                            <TextBlock Text="Startup behavior, updates, and core system settings." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Monitoring Card -->
                            <Button x:Name="HomeMonitoringBtn" Click="HomeCard_Click" Tag="Monitoring" Width="280" Height="110" Margin="0,0,0,16" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" 
                                        BorderThickness="1" 
                                        Padding="16" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="FourBars" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Monitoring" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                            <TextBlock Text="Select CPU, GPU, and Network hardware sensors." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Appearance Card -->
                            <Button x:Name="HomeAppearanceBtn" Click="HomeCard_Click" Tag="Appearance" Width="280" Height="110" Margin="0,0,16,0" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" 
                                        BorderThickness="1" 
                                        Padding="16" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Edit" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                            <TextBlock Text="Customize themes, colors, and font styles." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- About Card -->
                            <Button x:Name="HomeAboutBtn" Click="HomeCard_Click" Tag="About" Width="280" Height="110" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" 
                                        BorderThickness="1" 
                                        Padding="16" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Help" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="About" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                            <TextBlock Text="Version info, documentation, and support links." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </UniformGrid>

                        <!-- InfoBar Replacement -->
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4" Padding="16" Margin="0,20,0,0" BorderBrush="{DynamicResource SystemAccentColorBrush}" BorderThickness="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Accept" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Performance Note" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="Your system is being monitored using low-level Win32 APIs for maximum precision." Opacity="0.8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- General Section -->
                    <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                        <TextBlock Text="General" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        
                        <StackPanel Grid.IsSharedSizeScope="True">
<!-- Column 0 -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE7B3;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Show Overlay" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Enable or disable the monitor." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Config.ShowOverlay, Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE718;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Lock Position" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Prevent accidental dragging." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Config.LockPosition, Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE72A;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Run at Startup" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Launch with Windows." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Config.LaunchOnStartup, Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <!-- Column 2 -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE740;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Hide in Fullscreen" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Hide during games/movies." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Config.HideOnFullscreen, Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE90E;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Snap to Taskbar" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Dock to the taskbar area." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Config.StickToTaskbar, Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE819;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Keep on Top" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Stay above other windows." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Config.AlwaysOnTop, Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <!-- Row 3: Performance -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE916;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Refresh Rate" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Set how often the monitor updates its metrics." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <ComboBox Grid.Column="2" SelectedValue="{Binding Config.UpdateInterval, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource SettingsComboStyle}">
                                        <ComboBoxItem Content="500ms (High Performance)">
                                            <ComboBoxItem.Tag>
                                                <sys:Int32>500</sys:Int32>
                                            </ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="1000ms (Default)">
                                            <ComboBoxItem.Tag>
                                                <sys:Int32>1000</sys:Int32>
                                            </ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="2000ms (Relaxed)">
                                            <ComboBoxItem.Tag>
                                                <sys:Int32>2000</sys:Int32>
                                            </ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="5000ms (Power Saver)">
                                            <ComboBoxItem.Tag>
                                                <sys:Int32>5000</sys:Int32>
                                            </ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Row 4: Process list default sort -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE8CB;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Process List Sort" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Default sort when opening the process list from the overlay." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="ProcessSortCombo" SelectedValue="{Binding Config.ProcessListSortColumn, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource SettingsComboStyle}" SelectionChanged="ProcessSortCombo_SelectionChanged">
                                        <ComboBoxItem Content="Name" Tag="Name"/>
                                        <ComboBoxItem Content="CPU" Tag="Cpu"/>
                                        <ComboBoxItem Content="Memory" Tag="Memory"/>
                                        <ComboBoxItem Content="Disk" Tag="Disk"/>
                                        <ComboBoxItem Content="Network" Tag="Network"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Row 5: Process list icons -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE8B9;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Show Process Icons" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Show application icons in the process list." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Config.ProcessListShowIcons, Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <!-- Row 6: Overlay click mode -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE8B0;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Overlay Click Action" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Single click opens process list, or double-click opens Task Manager." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="OverlayClickModeCombo" SelectedValue="{Binding Config.OverlayClickMode, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource SettingsComboStyle}">
                                        <ComboBoxItem Content="Click → Process list" Tag="ProcessList"/>
                                        <ComboBoxItem Content="Double-click → Task Manager" Tag="TaskManager"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Row 7: Language -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE775;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Language" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Interface language for settings, menus, and process list." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="LanguageCombo" SelectedValue="{Binding Config.Language, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource SettingsComboStyle}" SelectionChanged="LanguageCombo_SelectionChanged">
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="Русский" Tag="ru"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Row 8: Debug log -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="{StaticResource SettingsIconGap}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Debug Log" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="Write diagnostic events (clicks, coordinates) to log/ folder. Off by default." Opacity="0.6" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" IsOn="{Binding Config.DebugLogEnabled, Mode=TwoWay}"/>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                        <TextBlock Text="Clear log after" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="DebugLogRetentionCombo" SelectedValue="{Binding Config.DebugLogRetention, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource SettingsComboStyle}" HorizontalAlignment="Right">
                                            <ComboBoxItem Content="1 day" Tag="Day"/>
                                            <ComboBoxItem Content="1 week" Tag="Week"/>
                                            <ComboBoxItem Content="1 month" Tag="Month"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Monitoring Section -->
                    <StackPanel x:Name="MonitoringSection" Visibility="Collapsed">
                        <TextBlock Text="Monitoring" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Telemetry Toggles -->
                            <StackPanel Grid.Column="0">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Margin="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <TextBlock Text="Hardware Telemetry" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1" CornerRadius="0,0,8,8" Padding="16">
                                    <StackPanel>
                                        <!-- CPU / RAM Group -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <ui:FontIcon Glyph="&#xE734;" FontSize="16" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Processor &amp; Memory" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="CPU Usage" VerticalAlignment="Center" Opacity="0.8"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                                     IsOn="{Binding Config.ShowCpu, Mode=TwoWay}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="RAM Usage" VerticalAlignment="Center" Opacity="0.8"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                                     IsOn="{Binding Config.ShowRam, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <ui:FontIcon Glyph="&#xE7AD;" FontSize="16" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Graphics &amp; Thermals" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="GPU Usage" VerticalAlignment="Center" Opacity="0.8"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                                     IsOn="{Binding Config.ShowGpu, Mode=TwoWay}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="GPU Temperature" VerticalAlignment="Center" Opacity="0.8"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                                     IsOn="{Binding Config.ShowTemp, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Background="{DynamicResource SystemControlElevationBorderBrush}" Margin="0,8,0,16" />

                                        <!-- Net / Disk Group -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <ui:FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Data &amp; Connectivity" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Upload Speed" VerticalAlignment="Center" Opacity="0.8"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                                     IsOn="{Binding Config.ShowNetUp, Mode=TwoWay}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Download Speed" VerticalAlignment="Center" Opacity="0.8"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                                     IsOn="{Binding Config.ShowNetDown, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <ui:FontIcon Glyph="&#xE7C1;" FontSize="16" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Storage Activity" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Used Space %" VerticalAlignment="Center" Opacity="0.8"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                                     IsOn="{Binding Config.ShowDisk, Mode=TwoWay}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Real-time Activity" VerticalAlignment="Center" Opacity="0.8"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                                                     IsOn="{Binding Config.ShowDiskSpeed, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: Hardware Selection & Advanced -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Hardware Selection" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                                        
                                        <TextBlock Text="Network Adapter" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="NetAdapterCombo" SelectedValue="{Binding Config.NetworkAdapter, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <ComboBoxItem Content="Default" Tag="Default" />
                                        </ComboBox>

                                        <TextBlock Text="Graphics Card" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="GpuAdapterCombo" SelectedValue="{Binding Config.GpuAdapter, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <ComboBoxItem Content="Default" Tag="Default" />
                                        </ComboBox>

                                        <TextBlock Text="Storage Drives" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DiskItems, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,8" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Value Alerts: пороги % и цвета warning/critical -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Value Alerts" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Percentage metrics (CPU, RAM, GPU, Disk) use these thresholds and colors." Opacity="0.6" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Warning Threshold" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Шкала 0–100 у обоих: thumb warning останавливается на (critical−5)% длины трека -->
                                            <Slider Minimum="0" Maximum="100"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding Config.WarningThresholdPercent, Mode=TwoWay}"
                                                    ValueChanged="WarningThresholdSlider_ValueChanged"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="40"
                                                       Text="{Binding Config.WarningThresholdPercent, StringFormat={}{0}%}"/>
                                        </Grid>
                                        <TextBlock Text="Warning Color" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <Button Style="{StaticResource SettingsColorButtonStyle}" Click="ColorButton_Click" Tag="Warning" Margin="0">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="{StaticResource SettingsSwatchSize}" Height="{StaticResource SettingsSwatchSize}" CornerRadius="3"
                                                        Background="{Binding Config.WarningColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="Select Warning" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Critical Threshold" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="100"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding Config.CriticalThresholdPercent, Mode=TwoWay}"
                                                    ValueChanged="CriticalThresholdSlider_ValueChanged"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="40"
                                                       Text="{Binding Config.CriticalThresholdPercent, StringFormat={}{0}%}"/>
                                        </Grid>
                                        <TextBlock Text="Critical Color" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <Button Style="{StaticResource SettingsColorButtonStyle}" Click="ColorButton_Click" Tag="Critical" Margin="0">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="{StaticResource SettingsSwatchSize}" Height="{StaticResource SettingsSwatchSize}" CornerRadius="3"
                                                        Background="{Binding Config.CriticalColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="Select Critical" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
                        <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Typography & Style -->
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Typography" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="Font Family" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <ComboBox SelectedValue="{Binding Config.FontFamily, Mode=TwoWay}" SelectedValuePath="Content" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <ComboBoxItem Content="Segoe UI" />
                                            <ComboBoxItem Content="Segoe UI Variable Display" />
                                            <ComboBoxItem Content="Inter" />
                                            <ComboBoxItem Content="Roboto" />
                                            <ComboBoxItem Content="Consolas" />
                                        </ComboBox>

                                        <TextBlock Text="Display Mode" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <ComboBox SelectedValue="{Binding Config.DisplayStyle, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <ComboBoxItem Content="Text" Tag="Text" />
                                            <ComboBoxItem Content="Compact" Tag="Compact" />
                                        </ComboBox>

                                        <ui:ToggleSwitch Header="Bold Text" IsOn="{Binding Config.IsTextBold, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 2: Color Palette -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Color Palette" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="Metric Accent" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <Button HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,12" Click="ColorButton_Click" Tag="Accent">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Config.AccentColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="Select Accent" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                            </Grid>
                                        </Button>

                                        <TextBlock Text="Label Tone" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <Button HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,12" Click="ColorButton_Click" Tag="Label">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Config.LabelColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="Select Label" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                            </Grid>
                                        </Button>

                                        <TextBlock Text="Capsule Color" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
                                        <Button HorizontalAlignment="Stretch" Height="36" Click="ColorButton_Click" Tag="Pod">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Config.PodColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="Select Capsule" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 3: Scaling & Background -->
                            <StackPanel Grid.Column="4">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Dashboard" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                                        <TextBlock Text="Scaling (Size)" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Config.ScaleFactor, Mode=TwoWay}" Margin="0,0,0,12"/>

                                         <TextBlock Text="Column Spacing" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider x:Name="ColumnSpacingSlider" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.ColumnSpacing, Mode=TwoWay}" Margin="0,0,0,12"/>

                                        <ui:ToggleSwitch Header="Enable Capsules" IsOn="{Binding Config.ShowPods, Mode=TwoWay}" Margin="0,0,0,8" />
                                        
                                        <ui:ToggleSwitch Header="Background Plate" IsOn="{Binding Config.ShowBackground, Mode=TwoWay}" Margin="0,0,0,8" />
                                        
                                        <Button HorizontalAlignment="Stretch" Height="32" Click="ColorButton_Click" Tag="Background" 
                                                Visibility="{Binding Config.ShowBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Config.BackgroundColorHex}" BorderBrush="White" BorderThickness="1"/>
                                                <TextBlock Grid.Column="1" Text="Select Plate Color" Margin="8,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Section Colors -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Section Colors" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Override label and metric colors per section. Leave unset to inherit global colors." Opacity="0.6" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <UniformGrid Columns="4">

                                    <!-- Network -->
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Network" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                                        <TextBlock Text="Label" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="NetLabel">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.NetLabelColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.NetLabelColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.NetLabelColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="UP / DN" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="NetLabel" Opacity="0.6" Margin="0,0,0,8">Clear</Button>
                                        <TextBlock Text="Metric" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="NetAccent">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.NetAccentColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.NetAccentColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.NetAccentColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="UP / DN" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="NetAccent" Opacity="0.6">Clear</Button>
                                    </StackPanel>

                                    <!-- CPU / RAM -->
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="CPU / RAM" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                                        <TextBlock Text="Label" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="CpuRamLabel">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.CpuRamLabelColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.CpuRamLabelColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.CpuRamLabelColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="CPU / RAM" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="CpuRamLabel" Opacity="0.6" Margin="0,0,0,8">Clear</Button>
                                        <TextBlock Text="Metric" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="CpuRamAccent">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.CpuRamAccentColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.CpuRamAccentColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.CpuRamAccentColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="CPU / RAM" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="CpuRamAccent" Opacity="0.6">Clear</Button>
                                    </StackPanel>

                                    <!-- GPU / Temp -->
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="GPU / Temp" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                                        <TextBlock Text="Label" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="GpuLabel">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.GpuLabelColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.GpuLabelColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.GpuLabelColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="GPU / TMP" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="GpuLabel" Opacity="0.6" Margin="0,0,0,8">Clear</Button>
                                        <TextBlock Text="Metric" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="GpuAccent">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.GpuAccentColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.GpuAccentColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.GpuAccentColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="GPU / TMP" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="GpuAccent" Opacity="0.6">Clear</Button>
                                    </StackPanel>

                                    <!-- Disk -->
                                    <StackPanel>
                                        <TextBlock Text="Disk" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                                        <TextBlock Text="Label" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="DiskLabel">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.DiskLabelColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.DiskLabelColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.DiskLabelColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Disk" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="DiskLabel" Opacity="0.6" Margin="0,0,0,8">Clear</Button>
                                        <TextBlock Text="Metric" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                                        <Button HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,4" Click="ColorButton_Click" Tag="DiskAccent">
                                            <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="White" BorderThickness="1">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.DiskAccentColorHex}" Value=""><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.DiskAccentColorHex}" Value="{x:Null}"><Setter Property="Background" Value="#333333"/></DataTrigger>
                                                    </Style.Triggers><Setter Property="Background" Value="{Binding Config.DiskAccentColorHex}"/></Style></Border.Style>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Disk" Margin="6,0" VerticalAlignment="Center" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" Height="24" FontSize="10" Click="ClearSectionColor_Click" Tag="DiskAccent" Opacity="0.6">Clear</Button>
                                    </StackPanel>

                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" Margin="0,24,0,0" Padding="16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ResetDefaultsBtn" Click="ResetToDefaults_Click" Padding="16,8" ui:ControlHelper.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Refresh" Margin="0,0,8,0" />
                                        <TextBlock Text="Reset Appearance" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- About Section -->
                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Kil0bit System Monitor" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="{Binding AppVersion}" Opacity="0.7" FontSize="13"/>
                            <TextBlock Text="A lightweight, high-performance system monitoring overlay designed for power users. Built with WPF and GDI+ rendering." 
                                       TextWrapping="Wrap" MaxWidth="600" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Separator Background="#1AFFFFFF" Margin="0,10"/>

                        <TextBlock Text="Connect with the Developer" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,12"/>
                        
                        <UniformGrid Columns="2" HorizontalAlignment="Left">
                            <ui:HyperlinkButton Content="YouTube (@kilObit)" Tag="loc:Settings.About.YouTube" NavigateUri="https://www.youtube.com/@kilObit" FontSize="14" Margin="0,0,16,10"/>
                            <ui:HyperlinkButton Content="GitHub (kil0bit-kb)" Tag="loc:Settings.About.GitHub" NavigateUri="https://github.com/kil0bit-kb" FontSize="14" Margin="0,0,0,10"/>
                            <ui:HyperlinkButton Content="Blog (kil0bit.blogspot.com)" Tag="loc:Settings.About.Blog" NavigateUri="https://kil0bit.blogspot.com/" FontSize="14" Margin="0,0,16,10"/>
                            <ui:HyperlinkButton Content="X (@kil0bit)" Tag="loc:Settings.About.X" NavigateUri="https://x.com/kil0bit" FontSize="14" Margin="0,0,0,10"/>
                            <ui:HyperlinkButton Content="Support Me (Patreon)" Tag="loc:Settings.About.Patreon" NavigateUri="https://www.patreon.com/cw/KB_kilObit" FontSize="14" Margin="0,0,16,10"/>
                        </UniformGrid>

                        <StackPanel Margin="0,30,0,0" Opacity="0.6">
                            <TextBlock Text="Built with вќ¤пёЏ by KB - kil0bit" HorizontalAlignment="Center" FontSize="12"/>
                            <TextBlock Text="В© 2026 Kil0bit System Monitor" HorizontalAlignment="Center" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ui:NavigationView>

        <!-- Footer -->
        <Border Grid.Row="1" Padding="24,16" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="QuitBtn" Grid.Column="0" Content="Quit Application" Tag="loc:Settings.Footer.Quit" Click="QuitButton_Click" 
                        Style="{StaticResource AccentButtonStyle}"
                        Background="#D32F2F" Foreground="White" 
                        HorizontalAlignment="Left" Padding="16,8" ui:ControlHelper.CornerRadius="4"/>
                
                <Button x:Name="ResetAppBtn" Grid.Column="1" Click="ResetApp_Click" 
                        Foreground="#FF6666"
                        HorizontalAlignment="Center" Padding="16,8" ui:ControlHelper.CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Refresh" Margin="0,0,8,0" />
                        <TextBlock x:Name="ResetAllText" Text="Reset All Settings" Tag="loc:Settings.Footer.ResetAll" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SaveCloseBtn" Grid.Column="2" Content="Save &amp; Close" Tag="loc:Settings.Footer.SaveClose" Click="SaveButton_Click" 
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Padding="24,8" ui:ControlHelper.CornerRadius="4"/>
            </Grid>
        </Border>
    </Grid>
</Window>

